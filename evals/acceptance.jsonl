{"id": "book_then_yes", "category": "happy_path", "actor": "cust_nikos", "turns": [{"user": "Find me a one way flight from Athens to Barcelona on 2026-12-03", "expect": {"tools_called": ["search_flights"], "tool_args": {"search_flights": {"origin": "ATH", "destination": "BCN"}}}}, {"user": "Book the cheapest one for me", "expect": {"tools_called": ["book_offer"]}}, {"user": "Yes, book it", "expect": {"writes_allowed": true, "writes_required": ["book_offer"]}}], "end_state": [{"new_booking": true, "cleanup": "cancel"}]}
